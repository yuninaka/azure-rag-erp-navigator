# Azure OpenAI Service
# デプロイ名は Azure OpenAI Studio(Foundry) > デプロイ で実際に作成した名前を指定する
# （モデル名と一致するとは限らない。本プロジェクトではサブスクリプションのクォータ制約で
# 選択肢が限られ、実際には下記の名前でデプロイしている。他環境では異なる名前になりうる）
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini-1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=erp-knowledge-index

# Azure Cosmos DB
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE_NAME=erp-navigator
AZURE_COSMOS_SESSIONS_CONTAINER=sessions
